import threading
import time
import os
import collections
import mycamera
import cv2
import numpy as np
import tensorflow as tf
from keras.metrics import MeanSquaredError
from tensorflow.keras.models import load_model
from gpiozero import DigitalOutputDevice, PWMOutputDevice

# ===== Motor Control =====
PWMA = PWMOutputDevice(18)
AIN1 = DigitalOutputDevice(22)
AIN2 = DigitalOutputDevice(27)

PWMB = PWMOutputDevice(23)
BIN1 = DigitalOutputDevice(25)
BIN2 = DigitalOutputDevice(24)

def motor_go(speed):
    AIN1.value = 0; AIN2.value = 1; PWMA.value = speed
    BIN1.value = 0; BIN2.value = 1; PWMB.value = speed

def motor_back(speed):
    AIN1.value = 1; AIN2.value = 0; PWMA.value = speed
    BIN1.value = 1; BIN2.value = 0; PWMB.value = speed

def motor_left(speed):
    AIN1.value = 1; AIN2.value = 0; PWMA.value = 0.0
    BIN1.value = 0; BIN2.value = 1; PWMB.value = speed

def motor_right(speed):
    AIN1.value = 0; AIN2.value = 1; PWMA.value = speed
    BIN1.value = 1; BIN2.value = 0; PWMB.value = 0.0

def motor_stop():
    AIN1.value = 0; AIN2.value = 1; PWMA.value = 0.0
    BIN1.value = 0; BIN2.value = 1; PWMB.value = 0.0

def motor_slow(speed):
    AIN1.value = 0; AIN2.value = 1; PWMA.value = speed/3
    BIN1.value = 0; BIN2.value = 1; PWMB.value = speed/3

speedSet = 0.6

# ===== Helper =====
def img_preprocess(image):
    h, _, _ = image.shape
    image = image[int(h/2):, :, :]
    image = cv2.cvtColor(image, cv2.COLOR_BGR2YUV)
    image = cv2.resize(image, (200, 66))
    image = cv2.GaussianBlur(image, (5,5), 0)
    return image / 255.0

# ===== Camera =====
camera = mycamera.MyPiCamera(640, 480)
_, image = camera.read()
image = cv2.flip(image, -1)
imagednn = image

image_ok = 0
image_find_ok = 0
carState = "stop"

# ===== (옵션) COCO 라벨 맵 일부 =====
LABELS = {
    0:"person", 1:"bicycle", 2:"car", 3:"motorcycle", 5:"bus", 7:"truck",
    9:"boat", 10:"traffic light", 11:"fire hydrant", 13:"stop sign"
}

# ===== EfficientDet-Lite0 (TFLite) 감지 스레드 =====
def tflite_detect_thread():
    """
    efficientdet-lite0.tflite 로 실시간 객체 감지.
    person(클래스 0) 보이면 carState='stop', 없으면 5초 뒤 'go'.
    """
    global image, imagednn, image_ok, image_find_ok, carState

    # --- 모델/라벨 경로 ---
    TFLITE_PATH = "/home/pi/AI_CAR/models/efficientdet-lite0.tflite"  # 경로 수정
    LABEL_PATH  = None  # 라벨 txt가 있으면 경로 지정 (한 줄당 클래스명)

    # --- 인터프리터 준비 (tensorflow 또는 tflite_runtime 둘 다 호환) ---
    try:
        from tflite_runtime.interpreter import Interpreter
    except Exception:
        from tensorflow.lite.python.interpreter import Interpreter

    interpreter = Interpreter(model_path=TFLITE_PATH, num_threads=2)
    interpreter.allocate_tensors()
    input_details  = interpreter.get_input_details()
    output_details = interpreter.get_output_details()

    # 입력 텐서 정보
    in_h, in_w = input_details[0]['shape'][1:3]
    in_dtype     = input_details[0]['dtype']     # uint8 or float32
    in_quant     = input_details[0].get('quantization', (0.0, 0))  # (scale, zero_point)

    # (옵션) 라벨 로드
    label_map = LABELS.copy()
    if LABEL_PATH:
        try:
            with open(LABEL_PATH, 'r', encoding='utf-8') as f:
                names = [l.strip() for l in f if l.strip()]
            label_map = {i: n for i, n in enumerate(names)}
        except:
            pass

    conf_thres = 0.50

    while True:
        if image_ok == 1:
            frame = image.copy()
            imagednn = frame.copy()
            ih, iw, _ = frame.shape

            # --- 전처리: 리사이즈 & 타입 맞추기 ---
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            resized = cv2.resize(rgb, (in_w, in_h))

            if in_dtype == np.uint8:
                inp = resized.astype(np.uint8)
                # (양자화 보정은 보통 필요 없음: tflite postprocess 노드가 처리)
            else:
                inp = resized.astype(np.float32) / 255.0

            inp = np.expand_dims(inp, axis=0)
            interpreter.set_tensor(input_details[0]['index'], inp)

            # --- 추론 ---
            interpreter.invoke()

            # EfficientDet-Lite 계열 TFLite 출력: boxes, classes, scores, num
            boxes   = interpreter.get_tensor(output_details[0]['index'])[0]   # [N,4] ymin,xmin,ymax,xmax (0~1)
            classes = interpreter.get_tensor(output_details[1]['index'])[0]   # [N]
            scores  = interpreter.get_tensor(output_details[2]['index'])[0]   # [N]
            # num   = interpreter.get_tensor(output_details[3]['index'])[0]

            person_found = False
            for i in range(len(scores)):
                score = float(scores[i])
                if score < conf_thres: 
                    continue
                cid = int(classes[i])
                ymin, xmin, ymax, xmax = boxes[i]
                x1, y1 = int(xmin*iw), int(ymin*ih)
                x2, y2 = int(xmax*iw), int(ymax*ih)

                # 시각화
                name = label_map.get(cid, str(cid))
                cv2.rectangle(imagednn, (x1,y1), (x2,y2), (23,230,210), 2)
                cv2.putText(imagednn, f"{name}:{score:.2f}", (x1, max(0,y1-6)),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,0,255), 2)

                # 사람 감지 시 정지
                if cid == 0:  # person
                    person_found = True

            if person_found:
                if carState != "stop":
                    print("person detected -> auto stop")
                carState = "stop"
            else:
                if carState == "stop":
                    print("No person detected, resuming after 5 seconds.")
                    time.sleep(5)
                    carState = "go"

            image_find_ok = 1

# ===== Q-FP16: UFLD .h5 -> FP16 .tflite 변환 + TFLite 추론 =====
try:
    from tflite_runtime.interpreter import Interpreter as _TFLiteInterpreter
except Exception:
    from tensorflow.lite.python.interpreter import Interpreter as _TFLiteInterpreter

def ensure_fp16_tflite(h5_path, out_path):
    if os.path.exists(out_path):
        return out_path
    model = load_model(h5_path, custom_objects={'mse': MeanSquaredError()})
    conv = tf.lite.TFLiteConverter.from_keras_model(model)
    conv.optimizations = [tf.lite.Optimize.DEFAULT]
    conv.target_spec.supported_types = [tf.float16]  # 핵심: Q-FP16
    tflite_model = conv.convert()
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, "wb") as f:
        f.write(tflite_model)
    return out_path

def load_tflite_interp(tflite_path, num_threads=2):
    itp = _TFLiteInterpreter(model_path=tflite_path, num_threads=num_threads)
    itp.allocate_tensors()
    return itp, itp.get_input_details(), itp.get_output_details()

def predict_fp16_tflite(interp, in_det, out_det, preimg):
    x = preimg.astype(in_det[0]['dtype'])[None, ...]   # [1,66,200,3]
    interp.set_tensor(in_det[0]['index'], x)
    t0 = time.time()
    interp.invoke()
    y = interp.get_tensor(out_det[0]['index'])
    dt = (time.time() - t0) * 1000.0
    return float(y[0][0]), dt  # angle, latency_ms

# quant 지표 집계(50프레임 평균 레이턴시/모델 크기)
_quant_lat = collections.deque(maxlen=50)
def report_quant_once(tflite_path):
    if len(_quant_lat) == 0:
        return
    size = os.path.getsize(tflite_path)
    avg_ms = sum(_quant_lat)/len(_quant_lat)
    print(f"quant: {{'method':'q-fp16','model_bytes':{size},'avg_latency_ms_50':{avg_ms:.2f}}}")
    _quant_lat.clear()


# ===== Main =====
def main():
    global image, imagednn, image_ok, image_find_ok, carState

    # ---- 경로 ----
    h5_path = "/home/pi/AI_CAR/model/UFLD_full_final.h5"              # UFLD 원본
    tflite_fp16 = "/home/pi/AI_CAR/model/UFLD_full_final_fp16.tflite" # UFLD FP16 TFLite

    # UFLD: 없으면 자동 변환(최초 1회) → 인터프리터 준비
    tflite_fp16 = ensure_fp16_tflite(h5_path, tflite_fp16)
    lane_itp, lane_in, lane_out = load_tflite_interp(tflite_fp16, num_threads=2)

    try:
        while True:
            k = cv2.waitKey(1)
            if k == ord('q'):
                break
            elif k == 82:   # ↑
                print("go"); carState = "go"
            elif k == 84:   # ↓
                print("stop"); carState = "stop"

            image_ok = 0
            _, frame = camera.read()
            frame = cv2.flip(frame, -1)
            image = frame
            image_ok = 1

            pre = img_preprocess(frame)
            cv2.imshow('pre', pre)

            if image_find_ok == 1:
                cv2.imshow("imagednn", imagednn)

            # ===== UFLD: Q-FP16 TFLite 추론 =====
            angle, ms = predict_fp16_tflite(lane_itp, lane_in, lane_out, pre)
            steering_angle = int(angle)
            _quant_lat.append(ms)
            if len(_quant_lat) == _quant_lat.maxlen:
                report_quant_once(tflite_fp16)  # 콘솔에 quant만 출력

            if carState == "go":
                if 85 <= steering_angle <= 109:
                    print("go"); motor_go(speedSet)
                elif steering_angle > 110:
                    print("right"); motor_right(speedSet)
                elif steering_angle < 84:
                    print("left"); motor_left(speedSet)
            else:
                motor_stop()
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    # TFLite 감지 스레드 실행
    task1 = threading.Thread(target=tflite_detect_thread, daemon=True)
    task1.start()
    main()
    cv2.destroyAllWindows()
